rules_version = '2';

// Regras de seguranca do Firestore do CashCtrl.
//
// Principio: isolamento completo por UID (RN02). Cada usuario so pode ler/
// escrever documentos dentro do seu proprio "namespace" (users/{uid}/...).
// Nao ha colecoes globais acessiveis aos clientes.

service cloud.firestore {
  match /databases/{database}/documents {

    // --- Perfil do usuario + dados do negocio ---
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      // --- Subcolecoes privadas por usuario (RN02) ---

      // Movimentacoes (receitas e despesas)
      match /transactions/{txId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }

      // Orcamentos mensais por categoria
      match /budgets/{budgetId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }

      // Parque de insumos (materiais comprados p/ fabricar produtos)
      match /ingredients/{ingredientId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }

      // Produtos / fichas tecnicas (ticket)
      match /products/{productId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // Bloqueia qualquer outra colecao nao mapeada acima
    match /{document=**} {
      allow read, write: if false;
    }
  }
}